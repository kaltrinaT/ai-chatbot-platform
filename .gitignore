# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
infra/terraform/.build/

# docs-signer lambda deps (installed fresh by the workflow before zipping)
infra/lambda/docs-signer/node_modules/
infra/azure-functions/docs-signer/node_modules/
infra/azure-functions/docs-signer/package-lock.json
# local func-start config — always holds a real (test) shared secret
infra/azure-functions/docs-signer/local.settings.json
