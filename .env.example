# Neon Postgres connection string (or any Postgres URL)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# NextAuth
AUTH_SECRET=                # generate with: npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App / PAT used to trigger workflow_dispatch on the chatbot repo
GITHUB_PAT=
CHATBOT_REPO_OWNER=
CHATBOT_REPO_NAME=ai-chatbot
CHATBOT_DEPLOY_WORKFLOW=deploy-tenant.yml
CHATBOT_DEPLOY_REF=main

# Shared secret the deploy workflow sends back when posting status updates
DEPLOY_WEBHOOK_SECRET=
