# Neon Postgres connection string (or any Postgres URL)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# NextAuth
AUTH_SECRET=                # generate with: npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional. Email addresses on the GitHub accounts allowed to sign in,
# comma-separated. Unset, any account that completes the GitHub OAuth flow
# reaches the platform, which is the model the prototype documents. Set, only
# these accounts may hold a session, checked at sign-in and on every request
# after it. Worth setting wherever the platform is reachable from the internet.
AUTH_ALLOWED_EMAILS=

# PAT used to dispatch the deploy, destroy and verify workflows and to read
# their progress. The workflows live in THIS repo, so REPO_OWNER/REPO_NAME
# point at this repo. PAT needs `repo` + `workflow` scopes.
GITHUB_PAT=
CHATBOT_REPO_OWNER=               # e.g. your-github-username
CHATBOT_REPO_NAME=ai-chatbot-platform
# The AWS workflows. The Azure ones are fixed: deploy-tenant-azure.yml and
# destroy-tenant-azure.yml.
CHATBOT_DEPLOY_WORKFLOW=deploy-tenant.yml
CHATBOT_DESTROY_WORKFLOW=destroy-tenant.yml
CHATBOT_DEPLOY_REF=main

# Shared secret the workflows send back when posting status updates. Must equal
# the PLATFORM_WEBHOOK_SECRET repository secret in GitHub.
DEPLOY_WEBHOOK_SECRET=

# 32-byte hex key for AES-256-GCM encryption of stored LLM API keys at rest.
# Generate with: openssl rand -hex 32
PLATFORM_ENCRYPTION_KEY=

# AWS profile the platform signs in through, for onboarding's sts:AssumeRole
# into each tenant's deployment role (which then writes the LLM key to their
# Secrets Manager). Never an access key: the platform refuses long-lived keys.
# The profile assumes the role in infra/platform/control-plane (see the top of
# its main.tf) from a sign-in session. Sign in, and again whenever the session
# expires, with: aws login --profile platform-operator
AWS_PROFILE=platform-control-plane

# Set this INSTEAD of AWS_PROFILE on a host that signs its own OIDC token, such
# as Vercel: the application exchanges that token for the same role, so there is
# no profile, no sign-in and no key. Leave blank for local development.
PLATFORM_AWS_ROLE_ARN=

# The platform's own AWS account ID (12 digits). Not a credential and not used
# to call AWS: it is the principal the onboarding wizard writes into the trust
# policy it shows each AWS customer, for the one statement that lets onboarding
# store their API keys in their own Secrets Manager. Unset, that policy renders
# with a placeholder the customer has to replace by hand, and the one-click AWS
# bootstrap is hidden because its link cannot be built.
PLATFORM_AWS_ACCOUNT_ID=

# Where the customer bootstrap templates are published — the `template_base_url`
# output of infra/platform/bootstrap-templates, e.g.
# https://ai-chatbot-platform-bootstrap.s3.eu-central-1.amazonaws.com
#
# Both clouds fetch their template over the public internet (CloudFormation
# server-side, the Azure portal from the customer's browser), so neither can
# read one from this application or from a private repository. Unset, the
# wizard falls back to the manual setup instructions, which create the same
# thing by hand.
PLATFORM_BOOTSTRAP_TEMPLATE_BASE_URL=

# Set to false for customer accounts AWS has not verified for CloudFront: such
# an account cannot create a distribution at all, and the deploy fails on it.
# Those tenants are then served by their load balancer directly, over plain
# HTTP unless they bring a TLS certificate. Unset, every AWS tenant without a
# certificate is fronted by CloudFront, which is what gives them HTTPS.
PLATFORM_ENABLE_CDN=

# Source chatbot (backend) image in YOUR ECR (no tag — the chatbot version is appended).
# Required for all tenant deploys (AWS and Azure) — replicated into whichever
# cloud the tenant deploys into.
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/chatbot
PLATFORM_CHATBOT_IMAGE_URI=

# Source chat-UI (frontend) image in YOUR ECR (no tag — the chatbot version is appended).
# Required for all tenant deploys (AWS and Azure) — replicated into whichever
# cloud the tenant deploys into.
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/chatbot-frontend
PLATFORM_FRONTEND_IMAGE_URI=

# Public URL of your already-deployed reference chatbot (the same app clients get).
# When set, a "Demo chatbot" button on the dashboard opens it in a new tab.
# e.g. http://chatbot-demo-1234567890.us-east-1.elb.amazonaws.com
DEMO_CHATBOT_URL=
